PREFIX acad: <../ontologia.ttl#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?docente ?area WHERE {
  VALUES ?a { <../recursos.html#area-dados-abertos> }
  ?p a acad:Docente ;
     schema:name ?docente ;
     acad:area ?a .
  ?a skos:prefLabel ?area .
}
ORDER BY ?docente
