    skos:prefLabel "Áreas temáticas do diretório"@pt-BR .

<recursos.html#instituicao> a schema:CollegeOrUniversity ;
    schema:name "Universidade Federal Rural do Rio de Janeiro (UFRRJ)"@pt-BR .

