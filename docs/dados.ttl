@prefix acad: <ontologia.ttl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<dados.ttl> a dcat:Dataset ;
    dct:conformsTo <ontologia.ttl> ;
    dct:description "A universidade, os cursos e as unidades seguem a estrutura da UFRRJ. Os perfis pessoais, vínculos individuais e produções são fictícios e foram criados para o trabalho de Web Semântica."@pt-BR ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:modified "2026-11-25"^^xsd:date ;
    dct:source <dados.json> ;
    dct:title "Diretório de perfis acadêmicos"@pt-BR .

<recursos.html#producao-acervo> a acad:Producao ;
    acad:ano "2025"^^xsd:gYear ;
    acad:autor <perfis/luiza-rocha.html> ;
    schema:name "Classificação de documentos do acervo"@pt-BR .

<recursos.html#producao-dados> a acad:Artigo ;
    acad:ano "2024"^^xsd:gYear ;
    acad:autor <perfis/ana-martins.html>,
        <perfis/bruno-ribeiro.html> ;
    schema:name "Integração de dados acadêmicos com RDF"@pt-BR .

<recursos.html#producao-prototipo> a acad:Producao ;
    acad:ano "2025"^^xsd:gYear ;
    acad:autor <perfis/joao-mendes.html> ;
    schema:name "Protótipo de catálogo acadêmico"@pt-BR .

<recursos.html#producao-vocabularios> a acad:Artigo ;
    acad:ano "2025"^^xsd:gYear ;
    acad:autor <perfis/ana-martins.html> ;
    schema:name "Vocabulários para diretórios acadêmicos"@pt-BR .

<perfis/bruno-ribeiro.html> a acad:Docente ;
    acad:area <recursos.html#area-dados-abertos>,
        <recursos.html#area-ia> ;
    acad:departamento <recursos.html#departamento-computacao> ;
    acad:disciplina <recursos.html#disciplina-ia> ;
    acad:formacao "Doutorado em Ciência da Computação (2020)",
        "Mestrado em Informática (2015)" ;
    acad:grupo <recursos.html#grupo-sistemas> ;
    acad:participaDe <recursos.html#projeto-ia> ;
    acad:portalAcademico <https://orcid.org/> ;
    schema:affiliation <recursos.html#instituicao> ;
    schema:description "Trabalha com classificação de documentos e recuperação de informação. Coordena atividades de pesquisa sobre inteligência artificial aplicada a acervos."@pt-BR ;
    schema:jobTitle "Professor adjunto"@pt-BR ;
    schema:name "Bruno Ribeiro Costa"@pt-BR .

<perfis/joao-mendes.html> a acad:Discente ;
    acad:area <recursos.html#area-dados-abertos>,
        <recursos.html#area-web-semantica> ;
    acad:curso <recursos.html#curso-sistemas> ;
    acad:disciplina <recursos.html#disciplina-banco-de-dados> ;
    acad:formacao "Bacharelado em Sistemas de Informação (em andamento)" ;
    acad:grupo <recursos.html#grupo-dados> ;
    acad:ingresso "2024"^^xsd:gYear ;
    acad:participaDe <recursos.html#projeto-dados> ;
    acad:portalAcademico <https://lattes.cnpq.br/> ;
    schema:affiliation <recursos.html#instituicao> ;
    schema:description "Estuda integração de dados e desenvolvimento web. Participa de um projeto para organizar e publicar dados acadêmicos."@pt-BR ;
    schema:jobTitle "Estudante de graduação"@pt-BR ;
    schema:name "João Mendes Pereira"@pt-BR .

<perfis/luiza-rocha.html> a acad:Discente ;
    acad:area <recursos.html#area-ia> ;
    acad:curso <recursos.html#curso-computacao> ;
    acad:disciplina <recursos.html#disciplina-ia> ;
    acad:formacao "Bacharelado em Ciência da Computação (em andamento)" ;
    acad:grupo <recursos.html#grupo-sistemas> ;
    acad:ingresso "2025"^^xsd:gYear ;
