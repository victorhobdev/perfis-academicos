    acad:portalAcademico <https://orcid.org/> ;
    schema:affiliation <recursos.html#instituicao> ;
    schema:description "Tem interesse em aprendizado de máquina e organização de acervos. Colabora com a avaliação de um classificador de documentos."@pt-BR ;
    schema:jobTitle "Estudante de graduação"@pt-BR ;
    schema:name "Luiza Rocha Almeida"@pt-BR .

