<perfis/ana-martins.html> a acad:Docente ;
    acad:area <recursos.html#area-dados-abertos>,
        <recursos.html#area-web-semantica> ;
    acad:departamento <recursos.html#departamento-computacao> ;
    acad:disciplina <recursos.html#disciplina-banco-de-dados>,
        <recursos.html#disciplina-web-semantica> ;
    acad:formacao "Doutorado em Ciência da Computação (2018)",
        "Graduação em Sistemas de Informação (2009)",
        "Mestrado em Informática (2012)" ;
    acad:grupo <recursos.html#grupo-dados> ;
    acad:participaDe <recursos.html#projeto-dados> ;
    acad:portalAcademico <https://lattes.cnpq.br/>,
        <https://orcid.org/> ;
    schema:affiliation <recursos.html#instituicao> ;
    schema:description "Pesquisa representação de conhecimento e dados abertos. Orienta trabalhos sobre integração de informação acadêmica com tecnologias da Web Semântica."@pt-BR ;
    schema:jobTitle "Professora associada"@pt-BR ;
    schema:name "Ana Martins da Silva"@pt-BR .

